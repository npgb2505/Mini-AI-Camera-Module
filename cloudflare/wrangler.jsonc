{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ro-mobile-assistant",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ro-mobile-assistant",
      "database_id": "3d127923-1429-4ad0-be9b-945ebd54104e",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}

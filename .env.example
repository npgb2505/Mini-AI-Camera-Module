# Copy to .env on the computer that runs the app. Never put this key in the browser.
RO_LOCAL_VISION_MODEL=qwen3-vl:4b-instruct
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
RO_DEVICE_BRIDGE_URL=http://127.0.0.1:8787
# After router setup, use the ESP32's router-assigned STA address shown by /wifi-setup.
# Example after router setup: RO_DEVICE_FIRMWARE_URL=http://<IP-STA>
# 192.168.4.1 is the setup AP, not the router-side address.
RO_DEVICE_FIRMWARE_URL=

# Optional: choose a different local detector weight file.
# YOLO_MODEL=D:\KLTN\Camera_Edge_AI_Khiem_Thi\yolo11n.pt
# RO_HOST=127.0.0.1
# RO_PORT=8790
